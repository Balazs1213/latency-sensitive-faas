apiVersion: apps/v1
kind: Deployment
metadata:
  name: {handler}-func
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {handler}-func
  template:
    metadata:
      labels:
        app: {handler}-func
    spec:
      enableServiceLinks: false
      containers:
        - name: {handler}-func
          image: adas-benchmark/{handler}:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8080
          readinessProbe:
            tcpSocket:
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 2
            failureThreshold: 60  
          resources:
            requests:
              cpu: "2500m"
              memory: "2048Mi"
            limits:
              cpu: "2500m"
              memory: "2048Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: {handler}-func
spec:
  selector:
    app: {handler}-func
  ports:
    - protocol: TCP
      port: 80
      targetPort: 8080
  type: NodePort
