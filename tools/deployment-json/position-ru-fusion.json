{
  "function_app": {
    "name": "position-ru-fusion",
    "runtime": "python",
    "latency_limit": 1000,
    "platform_managed": false,
    "components": [
      { "name": "position-service", "memory": 128, "runtime": 20, "files": ["position_core.py"] },
      { "name": "ru-fusion-service", "memory": 128, "runtime": 20, "files": ["ru_fusion.py"] }
    ],
    "links": [
      {
        "from": "position-service",
        "to": "ru-fusion-service",
        "invocation_rate": { "min": 1.0, "max": 4.0 },
        "data_delay": 10
      }
    ]
  },
  "function_compositions": [
    { "id": "composition-position", "components": ["position-service"] },
    { "id": "composition-fusion", "components": ["ru-fusion-service"] }
  ],
  "deployments": [
    {
      "id": "deployment-position",
      "function_composition_id": "composition-position",
      "node": "knative-m02",
      "namespace": "application",
      "routing_table": {
        "position-service": [{ "to": "ru-fusion-service", "function": "deployment-fusion" }]
      }
    },
    {
      "id": "deployment-fusion",
      "function_composition_id": "composition-fusion",
      "node": "knative-m03",
      "namespace": "application",
      "routing_table": {}
    }
  ]
}
